# ------------------------------------------------------------------
# Supabase (usado por lib/supabase.ts)
# Pegue os dois valores na aba Cloud do workspace da Lovable.
# Use SEMPRE a publishable/anon key. A service role key nunca entra no app.
# ------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------
# API das telas (usado por lib/api.ts)
# Enquanto estiver vazio, o app roda em MODO SIMULADO: as telas
# funcionam com dados de exemplo, sem depender do back-end.
# ------------------------------------------------------------------
EXPO_PUBLIC_API_URL=
